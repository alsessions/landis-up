{
    "require": {
        "craftcms/ckeditor": "^5.9.0",
        "craftcms/cms": "^5.12.1",
        "mmikkel/cp-clearcache": "^2.0.1",
        "mmikkel/retcon": "^3.2.3",
        "nystudio107/craft-imageoptimize": "^5.0.8",
        "nystudio107/craft-seomatic": "^5.1.22",
        "solspace/craft-freeform": "^5.18.4",
        "topshelfcraft/wordsmith": "^5.1.0",
        "verbb/cp-nav": "^6.0.5",
        "verbb/expanded-singles": "^3.0.11",
        "vlucas/phpdotenv": "^3.4.0"
    },
    "require-dev": {
        "yiisoft/yii2-shell": "^2.0.3"
    },
    "autoload": {
        "psr-4": {
            "modules\\": "modules/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "audit": {
            "block-insecure": false
        },
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://composer.craftcms.com",
            "canonical": false
        }
    ]
}
